# ──────────────────────────────────────────────────────────────────────────
# PrivateDrop — variables d'environnement (exemple)
# Copier ce fichier en `.env` et remplir les valeurs.
# Aucune de ces valeurs ne doit être committée.
# ──────────────────────────────────────────────────────────────────────────

# ── Shopify (fournis par le Partner Dashboard / Shopify CLI) ────────────────
# La plupart sont injectées automatiquement par `shopify app dev`.
# Les renseigner manuellement n'est utile que pour un déploiement hébergé.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# URL publique de l'app (tunnel en dev, domaine en prod). Sans slash final.
# En dev avec `shopify app dev`, le CLI la définit automatiquement.
# Sur Vercel, mettre l'URL de production, ex : https://privatedrop-shopify-app.vercel.app
SHOPIFY_APP_URL=https://privatedrop-shopify-app.vercel.app

# Scopes V1 (lecture seule, minimaux).
SCOPES=read_products,read_customers

# ── App Proxy (page événement côté boutique — base posée en M1) ─────────────
# Sous-chemin du proxy : la page sera servie sous
#   https://maboutique.com/apps/<SUBPATH>/...
APP_PROXY_SUBPATH=privatedrop
APP_PROXY_PREFIX=apps

# ── Base de données (PostgreSQL — Neon recommandé) ──────────────────────────
# DATABASE_URL : une seule URL pour l'exécution ET les migrations.
#   Sur Neon, utiliser de préférence la connexion *directe* (non poolée) :
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require
#   (la connexion poolée "-pooler" fonctionne aussi pour l'exécution).
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/privatedrop?sslmode=require

# ── Secrets applicatifs (générer des valeurs aléatoires fortes) ─────────────
# Génère-les avec :  openssl rand -hex 32
ACCESS_COOKIE_SECRET=changeme-generate-32-bytes-hex
EMAIL_HASH_SALT=changeme-generate-32-bytes-hex
ENCRYPTION_KEY=changeme-generate-32-bytes-hex

# ── Divers ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
